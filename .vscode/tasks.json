{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tự động đồng bộ GitHub & Vercel (Chạy ngầm)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-WindowStyle",
        "Hidden",
        "-File",
        "${workspaceFolder}/scripts/auto-sync-github.ps1"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}

